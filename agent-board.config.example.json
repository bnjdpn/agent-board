{
  "github": { "owner": "YOUR_OWNER", "projectNumber": 1 },
  "board": { "statusField": "Status", "columns": ["Todo", "In Progress", "Done"], "filterFields": ["Platform"] },
  "jobs": {
    "directory": "~/agent-jobs/<date>/<job>",
    "cardPattern": "(?:card|issue)(?:\\s+[A-Za-z][\\w-]*)?\\s*#?(\\d+)|#(\\d+)",
    "adapters": [
      { "kind": "transcript", "pattern": "<engine>.log" },
      { "kind": "jsonl", "pattern": "<engine>.jsonl" },
      { "kind": "plain", "pattern": "notify.log" },
      { "kind": "plain", "pattern": "STATUS" },
      { "kind": "plain", "pattern": "RESULT*" }
    ]
  },
  "agents": { "default": { "engine": "codex", "model": "default", "effort": "medium" } },
  "control": {
    "stateFile": "agent-board.state.json",
    "holdFile": "~/agent-jobs/FILL_HOLD",
    "readyColumns": ["Todo"],
    "wip": { "Todo": 2, "In Progress": 3 }
  },
  "launcher": { "command": "your-job-launcher", "args": ["--card", "<card>", "--engine", "<engine>", "--model", "<model>", "--effort", "<effort>"] }
}
