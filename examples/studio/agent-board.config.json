{
  "github": {
    "owner": "bnjdpn",
    "projectNumber": 1
  },
  "board": {
    "statusField": "Status",
    "columns": [
      "Idées",
      "À cadrer",
      "Prêt",
      "En cours",
      "Relecture",
      "À livrer",
      "En validation store",
      "Terminé"
    ],
    "filterFields": [
      "Plateforme"
    ]
  },
  "jobs": {
    "directory": "~/Documents/Apps/archives/jobs/<date>/<job>",
    "cardPattern": "(?:carte|card|issue)(?:\\s+[A-Za-z][\\w-]*)?\\s*#?(\\d+)|#(\\d+)",
    "adapters": [
      {
        "kind": "transcript",
        "pattern": "<engine>.log"
      },
      {
        "kind": "jsonl",
        "pattern": "<engine>.jsonl"
      },
      {
        "kind": "plain",
        "pattern": "notify.log"
      },
      {
        "kind": "plain",
        "pattern": "STATUS"
      },
      {
        "kind": "plain",
        "pattern": "RESULT*"
      }
    ]
  },
  "agents": {
    "default": {
      "engine": "codex",
      "model": "default",
      "effort": "medium"
    }
  },
  "controller": {
    "kind": "studio",
    "command": "~/.local/bin/studio"
  }
}
